# Copy this file to .env and fill in real keys to switch from mock data to
# live catalog results. The server runs fine with none of these set — it
# just falls back to small hand-written mock results per source.

# TMDB (movies/docs): free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# YouTube Data API v3: free tier key via https://console.cloud.google.com
YOUTUBE_API_KEY=

# arXiv needs no key — it's a public API, used automatically.

# Optional: change the port the MCP server listens on (default 8000)
PORT=8000

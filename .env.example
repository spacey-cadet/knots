# Copy this file to .env. The server runs with none of these set: it falls
# back to a heuristic extractor, and catalogs return nothing without keys.

# --- Interest extraction (Amazon Bedrock) ---------------------------------
# auto (default): try Bedrock, silently fall back to the heuristic on any failure
# bedrock:        same, but set EXTRACTOR_STRICT=1 to raise instead of falling back
# heuristic:      never call Bedrock
EXTRACTOR=auto
# A model ID or inference-profile ID you have access to in your region
# (Bedrock console -> Model access). Must support the Converse API and tool use.
BEDROCK_MODEL_ID=
AWS_REGION=us-east-1
# Credentials come from the standard AWS chain (env vars, ~/.aws, or an IAM role
# when deployed). Never put keys in this repo.
# BEDROCK_TIMEOUT_S=20

# --- Memory (used only when a caller passes a user_id) ---------------------
# auto: Titan embeddings if Bedrock is configured, else an offline hashed embedding
# EMBEDDER=auto
# EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
# SQLite file holding interests + embeddings (never conversation text)
# KNOTS_PROFILE_DB=data/knots_profile.db

# --- Catalogs --------------------------------------------------------------
# TMDB (films/docs): free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# YouTube Data API v3: key via https://console.cloud.google.com
# Used by thinking_partner and the eval; get_recommendations only uses it if INCLUDE_VIDEOS=1.
# Each search costs 100 of the 10,000 daily quota units; only the top 2 interests are searched.
YOUTUBE_API_KEY=
# INCLUDE_VIDEOS=1

# arXiv needs no key.

# Mock catalogs for a no-network demo/tests. Leave unset otherwise: with it unset,
# a missing key or failed catalog call returns nothing instead of fake titles.
# KNOTS_OFFLINE=1

# Port the MCP server listens on (default 8000)
PORT=8000

# Knots configuration.
#
#   cp .env.example .env      then fill in the blanks marked  <-- FILL IN
#
# server.py and eval/run_eval.py load .env automatically. A variable already set in your
# shell wins over .env. .env is gitignored: never commit it, never put keys in this repo.
#
# Everything works with no keys at all: Bedrock is skipped (heuristic extractor, hashed
# embeddings) and catalogs return nothing. Lines starting with # are optional switches
# that are off or at their default. Lines without # are safe as written; leave a
# value blank to keep that feature off. Do not leave NUMBERS blank.

# =============================================================================
# Amazon Bedrock: interest extraction + embeddings
# =============================================================================
# Credentials come from the standard AWS chain (aws configure / ~/.aws, env vars, or
# an IAM role when deployed). They do not go in this file.
AWS_REGION=us-east-1

# Model for interest extraction: a model ID or inference-profile ID you have access to
# in AWS_REGION (Bedrock console -> Model access). Must support the Converse API and tool
# use. Check its quota first (Service Quotas -> Amazon Bedrock): some models show 0 TPM.
# Blank = no Bedrock: the heuristic extractor is used.
BEDROCK_MODEL_ID=                       # <-- FILL IN

# auto (default): try Bedrock, silently fall back to the heuristic on any failure
# bedrock:        same, but EXTRACTOR_STRICT=1 makes failures raise instead of falling back
# heuristic:      never call Bedrock
EXTRACTOR=auto
# EXTRACTOR_STRICT=1                    # use for a first live check, then remove
BEDROCK_TIMEOUT_S=20

# =============================================================================
# Embeddings (ranking, pairing, memory)
# =============================================================================
# EMBEDDER:  auto   Cohere if EMBED_MODEL_ID names a Cohere model, else Titan if
#                   BEDROCK_MODEL_ID is set, else the offline hashed embedder
#            cohere | titan | hashed   force one
EMBEDDER=auto
#
# Recommended: Cohere Embed v4. It takes up to 96 texts per request, so a plan is one call.
#   Paste its inference-profile ID (Bedrock console -> Inference profiles; a global or
#   geo cross-region one: 20 requests/min and the quota can be raised). The plain
#   on-demand model ID is 10 requests/min and cannot be raised.
# Titan Text Embeddings V2 (amazon.titan-embed-text-v2:0) is the alternative: ONE text per
#   request and capped at 60 requests/min with no increase possible, so it is slow.
# Blank = Titan when BEDROCK_MODEL_ID is set.
EMBED_MODEL_ID=                         # <-- FILL IN (Cohere Embed v4 profile ID)
#
# Pacing and failure handling. Stay below your quota; throttling is retried with backoff,
# and after TITAN_BREAKER_FAILS failures in a row the run drops to the hashed embedder
# for TITAN_BREAKER_COOLDOWN_S seconds. (The TITAN_ names apply to Cohere too.)
COHERE_RPM=15
TITAN_RPM=50
TITAN_CONCURRENCY=3
TITAN_RETRIES=6
TITAN_BREAKER_FAILS=3
TITAN_BREAKER_COOLDOWN_S=30

# =============================================================================
# Memory (used only when a caller passes a user_id)
# =============================================================================
# SQLite file holding interests + embeddings (never conversation text).
# Default: data/knots_profile.db
# KNOTS_PROFILE_DB=data/knots_profile.db

# =============================================================================
# Catalogs
# =============================================================================
# TMDB (films/docs): free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=                           # <-- FILL IN

# YouTube Data API v3: key via https://console.cloud.google.com
# Used by thinking_partner and the eval; get_recommendations only uses it if INCLUDE_VIDEOS=1.
# Each search costs 100 of the 10,000 daily quota units; only the top 2 interests are searched.
YOUTUBE_API_KEY=                        # <-- FILL IN
# INCLUDE_VIDEOS=1

# arXiv needs no key. OpenAlex (paper citations) needs none either; adding your email
# puts you in its faster "polite pool".
# OPENALEX_MAILTO=you@example.com
# KNOTS_OPENALEX=0                      # skip OpenAlex citation lookups
# KNOTS_HTTP_TIMEOUT=5                  # seconds per catalog request (the eval uses 25)
# KNOTS_ARXIV_CACHE=eval/results/arxiv_cache.json   # the eval sets this itself

# Mock catalogs for a no-network demo/tests. Leave unset otherwise: with it unset, a
# missing key or failed catalog call returns nothing instead of fake titles.
# KNOTS_OFFLINE=1

# =============================================================================
# Server
# =============================================================================
# Port the MCP server listens on.
PORT=8000

# =============================================================================
# Learned parts and trust features (all optional)
# =============================================================================
# KNOTS_BRAIN=off            disable the theme judge and few-shot guidance
# KNOTS_THEME_THRESHOLD=0.5  override the shipped keep-threshold for unstated themes
# KNOTS_CHALLENGE=1          reserve one "challenge me" slot (a view that complicates yours)
